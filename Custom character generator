#include <LiquidCrystal.h>

LiquidCrystal lcd(12, 11, 5, 4, 3, 2);

// Custom 5x8 pixel bitmap data
byte Heart[8] = {
  0b00000,
  0b01010,
  0b11111,
  0b11111,
  0b01110,
  0b00100,
  0b00000,
  0b00000
};

byte Smiley[8] = {
  0b00000,
  0b10001,
  0b00000,
  0b00000,
  0b10001,
  0b01110,
  0b00000,
  0b00000
};

void setup() {
  lcd.begin(16, 2);
  
  // Map custom characters to memory slots 0 and 1
  lcd.createChar(0, Heart);
  lcd.createChar(1, Smiley);
  
  lcd.setCursor(0, 0);
  lcd.print("Custom Icons:");
  
  // Print custom characters using write()
  lcd.setCursor(0, 1);
  lcd.write(byte(0)); // Prints Heart
  lcd.print(" Arduino ");
  lcd.write(byte(1)); // Prints Smiley
}

void loop() {
  // Static display
}