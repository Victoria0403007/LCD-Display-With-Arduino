#include <LiquidCrystal.h>

LiquidCrystal lcd(12, 11, 5, 4, 3, 2);

void setup() {
  lcd.begin(16, 2);
  lcd.setCursor(0, 0);
  lcd.print("System Uptime:");
  lcd.setCursor(0, 1);
  lcd.print("Seconds: ");
}

void loop() {
  // Calculate seconds elapsed since board powered on
  unsigned long seconds = millis() / 1000;
  
  lcd.setCursor(9, 1);
  lcd.print(seconds);
  lcd.print("  "); // Clear trailing numbers if count shifts positions
  
  delay(100);
}
